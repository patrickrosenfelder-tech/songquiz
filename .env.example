# Apple Music (MusicKit) catalog API — secondary/fallback preview source.
# Generated from an Apple Developer account: Certificates, Identifiers & Profiles > Keys.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# Contents of the downloaded MusicKit .p8 private key file (keep this secret; never commit it).
APPLE_MUSIC_PRIVATE_KEY=
# Storefront country code for catalog search, e.g. us, gb, de. Defaults to "us".
APPLE_MUSIC_STOREFRONT=us

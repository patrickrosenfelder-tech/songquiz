# Copy to backend/.env and fill in. backend/.env is gitignored.

# Postgres connection. Locally: createdb tuneduel
# Hosted (Neon etc.): postgres://user:password@host/db?sslmode=require
DATABASE_URL=postgres://localhost/tuneduel

# Google sign-in: OAuth "Web application" client ID from console.cloud.google.com
# Leave empty to run without Google sign-in (dev login still works locally)
GOOGLE_CLIENT_ID=

PORT=4000

# Music preview provider routing.
# "deezer" or "apple" for either endpoint. Requests try PRIMARY_MUSIC_PROVIDER
# first and fall back to the other source automatically if it errors,
# times out, or returns no usable preview.
PRIMARY_MUSIC_PROVIDER=deezer

# Per-request timeout (ms) before a provider is treated as unavailable and
# the service falls back to the next one.
MUSIC_PROVIDER_TIMEOUT_MS=4000
